# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node.js / Next.js
node_modules/
.next/
out/
dist/
coverage/

# Local databases and database files
*.db
*.sqlite
*.sqlite3

# Uploaded files and temporary execution data
storage/course_materials/*
storage/submissions/*
storage/temporary/*
!storage/course_materials/.gitkeep
!storage/submissions/.gitkeep
!storage/temporary/.gitkeep

# Logs and temporary files
*.log
tmp/
temp/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
# Local test output
.pytest-tmp/

# Generated frontend types/cache
client/next-env.d.ts
*.tsbuildinfo

# Local proxy runtime
.runtime/

# SQLite WAL/SHM and new private judge storage
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
storage/code_submissions/*
storage/test_cases/*
!storage/code_submissions/.gitkeep
!storage/test_cases/.gitkeep
