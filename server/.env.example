DATABASE_URL=sqlite:///./database/lan_lms.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SECURE_COOKIE=false

# SQLite relative paths are resolved from the repository root.
# For LAN add the exact public web origin, e.g. http://192.168.1.10:8080.
# SECURE_COOKIE accepts only true or false; use true behind HTTPS.

# Optional: absolute private storage directory shared by API and workers.
# STORAGE_ROOT=D:/LAN-LMS-data/storage
# JUDGE_IMAGE=lan-lms-judge:day25
